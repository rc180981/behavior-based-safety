rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImageFile() {
      return request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024; // Maksimum 10MB sebelum kompresi
    }
    
    // Foto evidence observasi dan temuan
    match /evidence/{projectId}/{findingId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageFile();
    }
    
    // Standar kartu perilaku (diunggah Admin)
    match /standards/{itemId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageFile();
    }
  }
}
