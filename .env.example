# Firebase Client Configuration (Dapat diperoleh dari Project Settings > General > Your apps > Web app)
NG_APP_FIREBASE_API_KEY=your-api-key
NG_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=your-project-id
NG_APP_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NG_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NG_APP_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK Configuration for Vercel Serverless Functions (/api/*)
# Diperoleh dari Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# Private key harus diawali dengan "-----BEGIN PRIVATE KEY-----\n..." dan tanda kutip ganda
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
